        "1": "trained",
        "2": "certified",
        "3": "professional"
      }
    },
    {
      "code": "bleeding_control",
      "name": "Severe Bleeding Control & Tourniquet",
      "levels": {
        "1": "trained",
        "2": "certified",
        "3": "professional"
      }
    },
    {
      "code": "trauma_response",
      "name": "Musculoskeletal & Spinal Trauma Stabilization",
      "levels": {
        "1": "trained",
        "2": "certified",
        "3": "professional"
      }
    },
    {
      "code": "basic_first_aid",
      "name": "Basic First Aid & Wound Management",
      "levels": {
        "1": "trained",
        "2": "certified",
        "3": "professional"
      }
    },
    {
      "code": "advanced_life_support",
      "name": "Advanced Airway, Resuscitation & Medications",
      "levels": {
        "1": "trained",
        "2": "certified",
        "3": "professional"
      }
    }
  ],
  "responder_categories": [
